---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { alternatePaths, defaultLocale, type Locale } from '@/i18n';
import '@/styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	path?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
}

const { locale, title, description, path = '/', type = 'website', publishedTime } = Astro.props;

const alternates = alternatePaths(path);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale = locale === 'pt-br' ? 'pt_BR' : 'en_US';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Douglas Maia',
	url: Astro.site?.href,
	image: 'https://github.com/DouglasMai4.png',
	jobTitle: 'Full Stack Developer',
	worksFor: {
		'@type': 'Organization',
		name: 'Goalfy',
		url: 'https://goalfy.com.br',
	},
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Joinville',
		addressRegion: 'SC',
		addressCountry: 'BR',
	},
	sameAs: [
		'https://github.com/douglasmai4',
		'https://linkedin.com/in/douglasmai4',
		'https://t.me/douglasmai4',
	],
};
---

<!doctype html>
<html lang={locale === 'pt-br' ? 'pt-BR' : 'en'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Douglas Maia" />
		<meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0e1730" media="(prefers-color-scheme: dark)" />

		<script is:inline>
			(() => {
				const saved = localStorage.getItem('theme');
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			})();
		</script>

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		{
			alternates.map(({ hreflang, path: altPath }) => (
				<link rel="alternate" hreflang={hreflang} href={new URL(altPath, Astro.site)} />
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(alternates.find((a) => a.locale === defaultLocale)!.path, Astro.site)}
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://github.com/DouglasMai4.png" />
		<meta property="og:site_name" content="Douglas Maia" />
		<meta property="og:locale" content={ogLocale} />
		{
			type === 'article' && publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://github.com/DouglasMai4.png" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />

		<Analytics />
		<SpeedInsights />

		<script>
			// Section rules draw in once as they enter view (motion-safe only).
			if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				const titles = document.querySelectorAll<HTMLElement>('.section-title');
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							entry.target.classList.remove('awaiting-ink');
							observer.unobserve(entry.target);
						}
					},
					{ rootMargin: '0px 0px -15% 0px' },
				);
				for (const title of titles) {
					if (title.getBoundingClientRect().top > innerHeight) {
						title.classList.add('awaiting-ink');
						observer.observe(title);
					}
				}
			}
		</script>
	</body>
</html>
