---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { alternatePaths, defaultLocale, type Locale } from '@/i18n';
import '@/styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	path?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
}

const { locale, title, description, path = '/', type = 'website', publishedTime } = Astro.props;

const alternates = alternatePaths(path);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale = locale === 'pt-br' ? 'pt_BR' : 'en_US';

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Douglas Maia',
	url: Astro.site?.href,
	image: 'https://github.com/DouglasMai4.png',
	jobTitle: 'Full Stack Developer',
	worksFor: {
		'@type': 'Organization',
		name: 'Kingdom Softwares',
		url: 'https://kingdomsoftwares.com.br',
	},
	sameAs: [
		'https://github.com/douglasmai4',
		'https://linkedin.com/in/douglasmai4',
		'https://t.me/douglasmai4',
	],
};
---

<!doctype html>
<html lang={locale === 'pt-br' ? 'pt-BR' : 'en'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Douglas Maia" />
		<meta name="theme-color" content="#1a1a1a" />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		{
			alternates.map(({ hreflang, path: altPath }) => (
				<link rel="alternate" hreflang={hreflang} href={new URL(altPath, Astro.site)} />
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(alternates.find((a) => a.locale === defaultLocale)!.path, Astro.site)}
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://github.com/DouglasMai4.png" />
		<meta property="og:site_name" content="Douglas Maia" />
		<meta property="og:locale" content={ogLocale} />
		{
			type === 'article' && publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://github.com/DouglasMai4.png" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />

		<Analytics />
		<SpeedInsights />

		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('in-view');
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '-50px', threshold: 0.1 },
			);

			for (const el of document.querySelectorAll('.animate-in-view')) {
				observer.observe(el);
			}
		</script>
	</body>
</html>
