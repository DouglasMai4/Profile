---
import { getDict, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<footer class="sheet mt-[calc(var(--cell)*6)] pb-[calc(var(--cell)*4)] sm:pb-cell">
	<span class="in-margin margin-note pt-cell tabular">© {new Date().getFullYear()}</span>
	<div class="flex flex-wrap justify-between gap-x-6 gap-y-1 border-t-2 border-line pt-cell pb-cell text-sm text-muted">
		<p>Douglas Maia · {t.footer.made}</p>
		<a href="#top" class="ink-link">{t.footer.top} ↑</a>
	</div>
</footer>
