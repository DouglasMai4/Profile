---
import { ArrowUpRight, Mail, MessageCircle, Send, Terminal } from '@lucide/astro';

import Badge from '@/components/ui/Badge.astro';
import { getDict, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

const contacts = [
	{
		name: 'WhatsApp',
		description: t.contact.items.whatsapp,
		value: '+55 47 99769-4522',
		link: 'https://wa.me/5547997694522',
		Icon: MessageCircle,
		svg: null,
		color: 'text-emerald-500',
		hover: 'hover:bg-emerald-500/10 hover:border-emerald-500/50 hover:shadow-emerald-500/20',
	},
	{
		name: 'LinkedIn',
		description: t.contact.items.linkedin,
		value: 'in/douglasmai4',
		link: 'https://linkedin.com/in/douglasmai4',
		Icon: null,
		svg: 'linkedin',
		color: 'text-blue-500',
		hover: 'hover:bg-blue-500/10 hover:border-blue-500/50 hover:shadow-blue-500/20',
	},
	{
		name: 'GitHub',
		description: t.contact.items.github,
		value: 'douglasmai4',
		link: 'https://github.com/douglasmai4',
		Icon: null,
		svg: 'github',
		color: 'text-gray-500',
		hover: 'hover:bg-gray-500/10 hover:border-gray-500/50 hover:shadow-gray-500/20',
	},
	{
		name: 'Telegram',
		description: t.contact.items.telegram,
		value: '@douglasmai4',
		link: 'https://t.me/douglasmai4',
		Icon: Send,
		svg: null,
		color: 'text-sky-500',
		hover: 'hover:bg-sky-500/10 hover:border-sky-500/50 hover:shadow-sky-500/20',
	},
	{
		name: 'Email',
		description: t.contact.items.email,
		value: 'contato@douglasmaia.dev.br',
		link: 'mailto:contato@douglasmaia.dev.br',
		Icon: Mail,
		svg: null,
		color: 'text-zinc-200',
		hover: 'hover:bg-zinc-500/10 hover:border-zinc-500/50 hover:shadow-zinc-500/20',
	},
];
---

<section
	id="contact"
	class="py-24 px-4 relative bg-background overflow-hidden flex flex-col justify-between min-h-[60vh]"
>
	<div
		class="absolute inset-0 bg-[radial-gradient(circle_at_bottom,var(--tw-gradient-stops))] from-primary/10 via-background to-background pointer-events-none"
	>
	</div>

	<div class="container mx-auto max-w-5xl relative z-10">
		<div class="flex flex-col items-center mb-16 text-center space-y-6 animate-in-view">
			<Badge>
				<Terminal class="w-4 h-4 mr-2" />
				{t.contact.badge}
			</Badge>

			<h2 class="text-4xl md:text-5xl font-bold font-mono tracking-tight">
				{t.contact.titleLine1}
				<br />
				<span class="text-primary">{t.contact.titleLine2Highlight}</span>
			</h2>

			<p class="text-muted-foreground text-lg max-w-xl" set:html={t.contact.descriptionHtml} />
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			{
				contacts.map(({ name, description, value, link, Icon, svg, color, hover }, index) => (
					<a
						href={link}
						target="_blank"
						rel="noopener noreferrer"
						class:list={[
							'group relative p-6 rounded-2xl bg-zinc-900/40 border border-white/5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl md:last:col-span-2 animate-in-view',
							hover,
						]}
						style={`--stagger: ${index * 0.1}s`}
					>
						<div class="flex items-center justify-between mb-4">
							<div
								class:list={[
									'p-3 rounded-xl bg-white/5 group-hover:scale-110 transition-transform duration-500',
									color,
								]}
							>
								{Icon && <Icon class="w-6 h-6" />}
								{svg === 'github' && (
									<svg role="img" viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor">
										<title>GitHub</title>
										<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
									</svg>
								)}
								{svg === 'linkedin' && (
									<svg role="img" viewBox="0 0 24 24" class="w-6 h-6" fill="currentColor">
										<title>LinkedIn</title>
										<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
									</svg>
								)}
							</div>
							<ArrowUpRight class="w-5 h-5 text-zinc-500 group-hover:text-foreground group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-300" />
						</div>

						<div>
							<h3 class="text-lg font-bold text-foreground mb-1 group-hover:text-white transition-colors">
								{name}
							</h3>
							<p class="text-sm text-zinc-500 mb-4 group-hover:text-zinc-400">{description}</p>
							<p class="font-mono text-xs text-primary/80 bg-primary/5 inline-block px-2 py-1 rounded border border-primary/10 group-hover:bg-primary/10 transition-colors">
								{value}
							</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
