---
import { ArrowUpRight } from '@lucide/astro';

import { getDict, type Locale } from '@/i18n';
import { contacts } from '@/data/profile';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const [primary, ...rest] = contacts;
---

<section id="contact" class="pt-[calc(var(--cell)*6)]" aria-labelledby="contact-title">
	<div class="sheet">
		<h2 id="contact-title" class="section-title">{t.contact.title}</h2>
	</div>
	<p class="sheet mt-cell"><span class="max-w-[40rem] block">{t.contact.intro}</span></p>

	<p class="sheet mt-[calc(var(--cell)*2)]">
		<a
			href={primary.href}
			class="group inline-flex flex-wrap items-baseline gap-x-3 text-[clamp(1.125rem,5vw,3rem)] leading-[calc(var(--cell)*2.5)] font-extrabold tracking-[-0.03em] text-ink underline decoration-2 decoration-ink/40 underline-offset-[0.18em]"
		>
			<span>{primary.value.split('@')[0]}@<wbr /><span class="whitespace-nowrap">{primary.value.split('@')[1]}
			<ArrowUpRight class="inline-block align-[-0.05em] ml-2 size-[0.7em] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true" /></span></span>
		</a>
	</p>

	<ul class="mt-[calc(var(--cell)*2)]">
		{
			rest.map(({ name, value, href }) => (
				<li class="sheet">
					<span class="in-margin margin-note pt-[calc(var(--cell)*0.5)] hidden md:block">{name}</span>
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center justify-between gap-4 border-t-[1.5px] border-grid py-[calc(var(--cell)*0.5)] hover:text-ink transition-colors"
					>
						<span><span class="md:hidden margin-note mr-2">{name}</span><span class="font-semibold">{value}</span></span>
						<ArrowUpRight class="size-4 text-ink transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
					</a>
				</li>
			))
		}
	</ul>
</section>
