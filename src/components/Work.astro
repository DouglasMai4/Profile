---
import { ArrowUpRight } from '@lucide/astro';

import { getDict, type Locale } from '@/i18n';
import { experience, projects, stack, yearRange } from '@/data/profile';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const year = String(new Date().getFullYear());

const techFor = (id: string) => stack.filter((tech) => tech.used.includes(id as never)).map((tech) => tech.name);
---

<section id="work" class="pt-[calc(var(--cell)*4)]" aria-labelledby="work-title">
	<div class="sheet">
		<h2 id="work-title" class="section-title">{t.work.title}</h2>
	</div>

	<h3 class="sheet mt-cell"><span class="font-bold text-xl tracking-tight">{t.work.experience}</span></h3>

	<ol class="mt-cell">
		{
			experience.map((job) => (
				<li class="sheet py-cell" data-place={job.id}>
					<p class="in-margin margin-note pt-0.5 tabular">
						{job.end ? yearRange(job.start, job.end, year) : `${job.start.slice(0, 4)}–${t.work.now}`}
					</p>
					<div>
						<p class="flex flex-wrap items-baseline gap-x-3">
							<span class="place-name text-2xl font-extrabold tracking-tight">
								{job.href ? (
									<a href={job.href} target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors">
										{job.company}
									</a>
								) : (
									job.company
								)}
							</span>
							<span class="text-muted">{job.role[locale]}</span>
						</p>
						<ul class="mt-[calc(var(--cell)*0.5)] max-w-[44rem] space-y-[calc(var(--cell)*0.5)]">
							{job.notes.map((note) => (
								<li class="relative pl-cell before:absolute before:left-1 before:top-[0.6em] before:h-0.5 before:w-2.5 before:bg-ink">
									{note[locale]}
								</li>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ol>

	<h3 class="sheet mt-[calc(var(--cell)*3)]"><span class="font-bold text-xl tracking-tight">{t.work.projects}</span></h3>

	<ul class="mt-cell">
		{
			projects.map((project) => (
				<li class="sheet py-cell" data-place={project.id}>
					<p class="in-margin margin-note pt-0.5">
						{project.status === 'building' ? t.work.building : t.work.live}
					</p>
					<article class:list={['grid gap-x-[calc(var(--cell)*2)] gap-y-cell', project.image && 'md:grid-cols-[minmax(0,1fr)_minmax(0,18rem)]']}>
						<div>
							<h4 class="flex flex-wrap items-baseline gap-x-3">
								<span class="place-name text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[calc(var(--cell)*2)] font-extrabold tracking-[-0.03em]">
									{project.name}
								</span>
								<span class="text-muted">{project.role[locale]}</span>
							</h4>
							<p class="mt-[calc(var(--cell)*0.5)] max-w-[40rem]">{project.summary[locale]}</p>
							<p class="mt-[calc(var(--cell)*0.75)] font-mono text-xs text-ink">{techFor(project.id).join(' · ')}</p>
							<p class="mt-cell flex flex-wrap gap-x-5 gap-y-1">
								{project.links.map((link) => (
									<a href={link.href} target="_blank" rel="noopener noreferrer" class="ink-link inline-flex items-center gap-1">
										{t.work.links[link.label]}
										<ArrowUpRight class="size-4" aria-hidden="true" />
									</a>
								))}
							</p>
						</div>
						{project.image && (
							<a
								href={project.links[0].href}
								target="_blank"
								rel="noopener noreferrer"
								tabindex="-1"
								aria-hidden="true"
								class="block border-2 border-line bg-paper overflow-hidden aspect-[3/2] self-start"
							>
								<img
									src={project.image}
									alt=""
									width="432"
									height="288"
									loading="lazy"
									decoding="async"
									class="size-full object-cover"
								/>
							</a>
						)}
					</article>
				</li>
			))
		}
	</ul>

	<p class="sheet mt-cell">
		<a href="https://github.com/douglasmai4" target="_blank" rel="noopener noreferrer" class="ink-link inline-flex items-center gap-1">
			{t.work.github}
			<ArrowUpRight class="size-4" aria-hidden="true" />
		</a>
	</p>
</section>
