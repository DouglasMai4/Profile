---
import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import PostRow from '@/components/PostRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDict, type Locale } from '@/i18n';
import { getPosts } from '@/lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const posts = await getPosts(locale);

const tagCounts = new Map<string, number>();
for (const post of posts) for (const tag of post.data.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout locale={locale} title={t.meta.blogTitle} description={t.meta.blogDescription} path="/blog/">
	<Navbar locale={locale} path="/blog/" />
	<main id="main" class="pt-[calc(var(--cell)*4)]">
		<header id="top" class="sheet">
			<p class="in-margin margin-note pt-cell tabular" data-count data-one={t.blog.count(1)} data-many={t.blog.count(999).replace('999', '{n}')}>{t.blog.count(posts.length)}</p>
			<div>
				<h1 class="text-[clamp(3.5rem,10vw,6rem)] leading-[0.95] font-extrabold tracking-[-0.04em]">{t.blog.title}</h1>
				<p class="mt-cell max-w-[36rem] text-lg leading-[calc(var(--cell)*1.25)]">{t.blog.description}</p>
			</div>
		</header>

		{
			posts.length === 0 ? (
				<p class="sheet mt-[calc(var(--cell)*3)] text-muted">{t.blog.empty}</p>
			) : (
				<>
					{tags.length > 1 && (
						<div class="sheet mt-[calc(var(--cell)*3)]">
							<div class="flex flex-wrap gap-1.5" role="group" aria-label={t.blog.filter} data-tag-filter>
								<button type="button" class="chip" data-tag="" aria-pressed="true">
									{t.blog.allTags}
								</button>
								{tags.map(([tag, count]) => (
									<button type="button" class="chip" data-tag={tag} aria-pressed="false">
										#{tag} <span class="ml-1.5 font-mono text-[0.6875rem] opacity-70">{count}</span>
									</button>
								))}
							</div>
						</div>
					)}

					<ul class="mt-[calc(var(--cell)*2)]" data-post-list>
						{posts.map((post) => (
							<PostRow locale={locale} post={post} headingLevel="h2" />
						))}
					</ul>
					<p class="sheet mt-cell text-muted" data-no-match hidden>
						{t.blog.noMatch}
					</p>
				</>
			)
		}
	</main>
	<Footer locale={locale} />
</BaseLayout>

<script>
	const filter = document.querySelector<HTMLElement>('[data-tag-filter]');
	const rows = document.querySelectorAll<HTMLElement>('[data-post-list] > li');
	const empty = document.querySelector<HTMLElement>('[data-no-match]');
	const count = document.querySelector<HTMLElement>('[data-count]');
	const label = (n: number) =>
		n === 1 ? (count?.dataset.one ?? '1') : (count?.dataset.many ?? '{n}').replace('{n}', String(n));

	function apply(tag: string, push: boolean) {
		if (!filter) return;
		let visible = 0;
		for (const row of rows) {
			const show = !tag || (row.dataset.tags ?? '').split(' ').includes(tag);
			row.hidden = !show;
			if (show) visible++;
		}
		for (const button of filter.querySelectorAll<HTMLButtonElement>('[data-tag]')) {
			button.setAttribute('aria-pressed', String(button.dataset.tag === tag));
		}
		if (empty) empty.hidden = visible > 0;
		if (count) count.textContent = label(visible);
		if (push) {
			const url = new URL(location.href);
			if (tag) url.searchParams.set('tag', tag);
			else url.searchParams.delete('tag');
			history.replaceState(null, '', url);
		}
	}

	filter?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
		if (button) apply(button.dataset.tag ?? '', true);
	});

	const initial = new URL(location.href).searchParams.get('tag');
	if (initial) apply(initial, false);
</script>
