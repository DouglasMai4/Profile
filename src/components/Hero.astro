---
import { ArrowRight, CodeXml, Terminal } from '@lucide/astro';

import Badge from '@/components/ui/Badge.astro';
import EncryptedText from '@/components/ui/EncryptedText.astro';
import ParticleAnimation from '@/components/ui/ParticleAnimation.astro';
import { getDict, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
---

<section id="hero" class="relative px-4 h-dvh flex items-center justify-center bg-background">
	<div class="absolute inset-0 z-0">
		<ParticleAnimation />

		<div
			class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-primary/5 via-background/0 to-background"
		>
		</div>
		<div class="absolute inset-0 bg-linear-to-b from-transparent via-background/50 to-background"></div>
	</div>

	<div
		class="container mx-auto max-w-6xl relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
	>
		<div class="space-y-8 text-center lg:text-left order-2 lg:order-1">
			<div class="flex justify-center lg:justify-start animate-in-view" style="--stagger: 0.3s">
				<Badge>
					<CodeXml class="w-4 h-4 mr-2 animate-pulse" />
					<EncryptedText text={t.hero.badge} revealDelayMs={50} />
				</Badge>
			</div>

			<h1
				class="text-4xl md:text-6xl lg:text-7xl font-bold font-mono tracking-tight text-foreground animate-in-view"
				style="--stagger: 0.5s"
			>
				{t.hero.titleStart}
				<span class="bg-clip-text text-transparent bg-linear-to-r from-primary via-sky-400 to-blue-500"
					>{t.hero.titleHighlight}</span
				>
			</h1>

			<p
				class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto lg:mx-0 leading-relaxed animate-in-view"
				style="--stagger: 0.7s"
			>
				{t.hero.description}
			</p>

			<div
				class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8 animate-in-view"
				style="--stagger: 0.9s"
			>
				<a
					href="#projects"
					class="group inline-flex items-center justify-center h-10 px-6 rounded-md text-base font-medium bg-primary hover:bg-primary/90 text-primary-foreground shadow-lg shadow-primary/20 transition-colors"
				>
					{t.hero.explore}
					<ArrowRight class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1" />
				</a>

				<a
					href="#contact"
					class="group inline-flex items-center justify-center h-10 px-6 rounded-md text-base font-medium border border-primary/20 hover:bg-primary/5 hover:border-primary/50 transition-colors"
				>
					{t.hero.talk}
					<Terminal class="ml-2 w-4 h-4 text-primary" />
				</a>
			</div>
		</div>

		<div class="order-1 lg:order-2 flex justify-center lg:justify-end mt-72 lg:mt-0 animate-in-view" style="--stagger: 0.5s">
			<div class="relative animate-float">
				<div
					class="relative bg-zinc-950/80 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden shadow-2xl w-full max-w-md"
				>
					<div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5">
						<div class="flex gap-2">
							<div class="w-3 h-3 rounded-full bg-red-500/80 shadow-sm"></div>
							<div class="w-3 h-3 rounded-full bg-yellow-500/80 shadow-sm"></div>
							<div class="w-3 h-3 rounded-full bg-green-500/80 shadow-sm"></div>
						</div>
						<div
							class="flex-1 text-center text-xs font-mono text-zinc-500 flex items-center justify-center gap-1.5 opacity-70"
						>
							<Terminal class="w-3 h-3" />
							developer.go
						</div>
					</div>

					<div class="p-6 font-mono text-sm leading-relaxed overflow-x-auto bg-zinc-900">
						<div class="flex">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">1</span>
							<div>
								<span class="text-yellow-200">developer</span>
								<span class="text-purple-400"> :=</span>
								<span class="text-teal-300"> Developer</span><span class="text-zinc-400">&lbrace;</span>
							</div>
						</div>

						<div class="flex hover:bg-white/5 transition-colors rounded">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">2</span>
							<div class="pl-4">
								<span class="text-sky-300">Name</span>:<span class="text-emerald-400">
									"Douglas V. Maia"</span
								>,
							</div>
						</div>

						<div class="flex hover:bg-white/5 transition-colors rounded">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">3</span>
							<div class="pl-4">
								<span class="text-sky-300">Skills</span>:
								<span class="text-purple-400">[]string</span><span class="text-zinc-400">&lbrace;</span><span
									class="text-orange-400">"React"</span
								>,{' '}
								<span class="text-orange-400">"Node"</span>,{' '}
								<span class="text-orange-400">"Go"</span><span class="text-zinc-400">&rbrace;</span>,
							</div>
						</div>

						<div class="flex hover:bg-white/5 transition-colors rounded">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">4</span>
							<div class="pl-4">
								<span class="text-sky-300">HardWorker</span>:<span class="text-blue-400"> true</span>,
							</div>
						</div>

						<div class="flex hover:bg-white/5 transition-colors rounded">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">5</span>
							<div class="pl-4">
								<span class="text-sky-300">Start</span>:
								<span class="text-purple-400">func</span><span class="text-zinc-400">()</span>
								<span class="text-teal-300">string</span>
								<span class="text-zinc-400">&lbrace;</span>
							</div>
						</div>

						<div class="flex hover:bg-white/5 transition-colors rounded">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">6</span>
							<div class="pl-8">
								<span class="text-red-300">return</span>
								<span class="text-emerald-400"> "{t.hero.terminalReturn}"</span>
							</div>
						</div>

						<div class="flex">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">7</span>
							<div class="pl-4">
								<span class="text-zinc-400">&rbrace;</span>,
							</div>
						</div>

						<div class="flex">
							<span class="text-zinc-600 select-none mr-4 text-right w-6">8</span>
							<div>
								<span class="text-zinc-400">&rbrace;</span>
								<span class="text-zinc-500 animate-pulse">|</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
