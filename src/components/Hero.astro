---
import { CornerDownLeft } from '@lucide/astro';

import { getDict, localePath, type Locale } from '@/i18n';
import { areas, experience, placeNames, projects, stack, yearRange } from '@/data/profile';
import { getPosts, postSlug, readingTimeMinutes } from '@/lib/blog';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const posts = await getPosts(locale);
const latest = posts[0];
const year = String(new Date().getFullYear());

// Every route of the pretend API, answered from the same data the page renders.
const routes: Record<string, unknown> = {
	'/douglas': {
		name: 'Douglas Maia',
		role: t.hero.role,
		at: { company: 'Goalfy', role: experience[0].role[locale] },
		founder_of: 'Kingdom Softwares',
		mentor_at: 'Escola da Nuvem',
		based_in: 'Joinville, SC · remote',
		next: ['/douglas/stack', '/douglas/experience', '/douglas/projects', '/douglas/posts/latest'],
	},
	'/douglas/stack': Object.fromEntries(
		areas.map((area) => [area, stack.filter((tech) => tech.area === area).map((tech) => tech.name)]),
	),
	...Object.fromEntries(
		areas.map((area) => [
			`/douglas/stack?area=${area}`,
			stack
				.filter((tech) => tech.area === area)
				.map((tech) => ({ name: tech.name, used_at: tech.used.map((id) => placeNames[id]) })),
		]),
	),
	'/douglas/experience': experience.map((job) => ({
		company: job.company,
		role: job.role[locale],
		years: yearRange(job.start, job.end, year),
	})),
	'/douglas/projects': projects.map((project) => ({
		name: project.name,
		role: project.role[locale],
		url: project.links[0]?.href,
	})),
	'/douglas/posts/latest': latest
		? {
				title: latest.data.title,
				date: latest.data.pubDate.toISOString().slice(0, 10),
				minutes: readingTimeMinutes(latest.body),
				url: localePath(locale, `/blog/${postSlug(latest)}/`),
			}
		: null,
};

const presets = [
	'/douglas',
	'/douglas/stack?area=backend',
	'/douglas/stack?area=ai',
	'/douglas/experience',
	'/douglas/projects',
];

const payload = { routes, notFound: t.api.notFound };
---

<section id="top" class="sheet pt-[calc(var(--cell)*4)] pb-[calc(var(--cell)*3)]">
	<p class="in-margin margin-note pt-[calc(var(--cell)*0.5)] hidden md:block">
		<time datetime={new Date().toISOString().slice(0, 10)} data-today>{new Date().toLocaleDateString('pt-BR')}</time>
	</p>

	<div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] gap-x-[calc(var(--cell)*3)] gap-y-[calc(var(--cell)*3)] items-start">
		<div>
			<h1 class="text-[clamp(3.5rem,10vw,6rem)] leading-[0.95] font-extrabold tracking-[-0.04em] text-text">
				Douglas<br />Maia
			</h1>
			<p class="mt-cell text-xl font-semibold text-ink">{t.hero.role}</p>
			<p class="mt-[calc(var(--cell)*1.5)] max-w-[34rem] text-lg leading-[calc(var(--cell)*1.25)] text-text">
				{t.hero.intro}
			</p>
		</div>

		<div class="ink-box" data-api>
			<div class="flex flex-wrap items-baseline justify-between gap-x-4 px-cell pt-[calc(var(--cell)*0.75)]">
				<h2 class="font-extrabold text-xl tracking-tight">{t.api.title}</h2>
				<p class="text-xs text-muted">{t.api.note}</p>
			</div>

			<form class="mx-cell mt-[calc(var(--cell)*0.75)] flex items-stretch border-b-2 border-ink" data-api-form>
				<label for="api-route" class="font-mono text-sm font-bold text-rule py-2 pr-2">GET</label>
				<input
					id="api-route"
					name="route"
					value={presets[1]}
					autocomplete="off"
					spellcheck="false"
					aria-label={t.api.label}
					aria-describedby="api-hint"
					class="flex-1 min-w-0 bg-transparent font-mono text-sm text-text py-2 outline-none caret-rule"
				/>
				<button type="submit" class="grid place-items-center px-2 text-ink hover:text-rule cursor-pointer" aria-label={t.api.send}>
					<CornerDownLeft class="size-4" aria-hidden="true" />
				</button>
			</form>

			<div class="mx-cell mt-[calc(var(--cell)*0.5)] flex flex-wrap gap-1.5" role="group" aria-label={t.api.routes}>
				{
					presets.map((route) => (
						<button type="button" class="chip font-mono !text-xs" data-route={route} aria-pressed={route === presets[1] ? 'true' : 'false'}>
							{route.replace('/douglas', '') || '/'}
						</button>
					))
				}
			</div>

			<div class="mt-cell border-t-2 border-ink">
				<p class="flex justify-between px-cell py-1 font-mono text-xs text-muted" aria-hidden="true">
					<span data-api-status>200 OK</span>
					<span data-api-time></span>
				</p>
				<pre
					class="px-cell pb-cell font-mono text-[0.8125rem] leading-[calc(var(--cell)*0.875)] h-[calc(var(--cell)*13)] overflow-auto text-text"
					data-api-output
					aria-live="polite"
					tabindex="0"><code>{JSON.stringify(routes[presets[1]], null, 2)}</code></pre>
			</div>
			<p id="api-hint" class="px-cell py-1 border-t-2 border-ink font-mono text-[0.6875rem] text-muted">{t.api.hint}</p>
		</div>
	</div>
</section>


<script is:inline type="application/json" id="api-data" set:html={JSON.stringify(payload)} />

<script>
	type Payload = { routes: Record<string, unknown>; notFound: string };

	const root = document.querySelector<HTMLElement>('[data-api]');
	const data = document.getElementById('api-data');

	const today = document.querySelector<HTMLTimeElement>('[data-today]');
	if (today) today.textContent = new Date().toLocaleDateString(document.documentElement.lang);

	if (root && data) {
		const { routes, notFound } = JSON.parse(data.textContent ?? '{}') as Payload;
		const form = root.querySelector<HTMLFormElement>('[data-api-form]')!;
		const input = root.querySelector<HTMLInputElement>('input')!;
		const output = root.querySelector<HTMLElement>('[data-api-output]')!;
		const status = root.querySelector<HTMLElement>('[data-api-status]')!;
		const time = root.querySelector<HTMLElement>('[data-api-time]')!;
		const chips = root.querySelectorAll<HTMLButtonElement>('[data-route]');
		const history: string[] = [];
		let cursor = -1;

		const normalize = (raw: string) => {
			let route = raw.trim().replace(/^get\s+/i, '').toLowerCase();
			if (!route.startsWith('/')) route = `/${route}`;
			if (!route.startsWith('/douglas')) route = `/douglas${route === '/' ? '' : route}`;
			return route.replace(/\/+(\?|$)/, '$1') || '/douglas';
		};

		const el = (tag: string, cls: string, text: string) => {
			const node = document.createElement(tag);
			node.className = cls;
			node.textContent = text;
			return node;
		};

		// Pretty-print JSON as nodes. Strings that are routes become runnable buttons.
		const render = (value: unknown, indent = 0, into: HTMLElement = document.createElement('code')) => {
			const pad = '  '.repeat(indent);
			if (Array.isArray(value)) {
				into.append(el('span', 'text-muted', '['));
				value.forEach((item, i) => {
					into.append(`\n${pad}  `);
					render(item, indent + 1, into);
					if (i < value.length - 1) into.append(el('span', 'text-muted', ','));
				});
				into.append(`\n${pad}`, el('span', 'text-muted', ']'));
			} else if (value && typeof value === 'object') {
				const entries = Object.entries(value);
				into.append(el('span', 'text-muted', '{'));
				entries.forEach(([key, item], i) => {
					into.append(`\n${pad}  `, el('span', 'text-ink', `"${key}"`), el('span', 'text-muted', ': '));
					render(item, indent + 1, into);
					if (i < entries.length - 1) into.append(el('span', 'text-muted', ','));
				});
				into.append(`\n${pad}`, el('span', 'text-muted', '}'));
			} else if (typeof value === 'string' && value.startsWith('/douglas')) {
				const link = el('button', 'underline decoration-rule underline-offset-2 hover:text-rule cursor-pointer', `"${value}"`);
				(link as HTMLButtonElement).type = 'button';
				link.addEventListener('click', () => run(value));
				into.append(link);
			} else if (typeof value === 'string' && /^(https?:)?\//.test(value)) {
				const link = el('a', 'underline decoration-rule underline-offset-2 hover:text-rule', `"${value}"`) as HTMLAnchorElement;
				link.href = value;
				into.append(link);
			} else if (typeof value === 'string') {
				into.append(el('span', 'text-text', `"${value}"`));
			} else {
				into.append(el('span', 'text-rule', String(value)));
			}
			return into;
		};

		const run = (raw: string, remember = true) => {
			const started = performance.now();
			const route = normalize(raw);
			const found = route in routes;
			const body = found
				? routes[route]
				: { error: `${route} → 404`, hint: notFound, try: Object.keys(routes).filter((r) => !r.includes('?')) };

			input.value = route;
			status.textContent = found ? '200 OK' : '404 Not Found';
			status.classList.toggle('text-rule', !found);
			output.replaceChildren(render(body));
			output.scrollTop = 0;
			time.textContent = `${(performance.now() - started).toFixed(2)} ms`;
			for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.route === route));

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				output.animate(
					[{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0 0)' }],
					{ duration: 420, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
				);
			}
			if (remember && history.at(-1) !== route) history.push(route);
			cursor = history.length;
		};

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			run(input.value);
		});

		input.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowUp' && event.key !== 'ArrowDown') return;
			if (history.length === 0) return;
			event.preventDefault();
			cursor = Math.max(0, Math.min(history.length - 1, cursor + (event.key === 'ArrowUp' ? -1 : 1)));
			input.value = history[cursor];
		});

		for (const chip of chips) chip.addEventListener('click', () => run(chip.dataset.route ?? '/douglas'));

		run(input.value);
	}
</script>
