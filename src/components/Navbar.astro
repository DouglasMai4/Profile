---
import { Moon, Sun } from '@lucide/astro';

import { alternatePaths, getDict, localePath, locales, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
	path?: string;
}

const { locale, path = '/' } = Astro.props;

const t = getDict(locale);
const home = localePath(locale, '/');
const isBlog = path.startsWith('/blog');

const navItems = [
	{ name: t.navbar.blog, href: localePath(locale, '/blog/'), id: 'blog' },
	{ name: t.navbar.work, href: `${home}#work`, id: 'work' },
	{ name: t.navbar.stack, href: `${home}#stack`, id: 'stack' },
	{ name: t.navbar.contact, href: `${home}#contact`, id: 'contact' },
];

const alternates = alternatePaths(path);
---

<a
	href="#main"
	class="sr-only focus:not-sr-only focus:fixed focus:top-cell focus:left-cell focus:z-50 focus:bg-ink focus:text-paper focus:px-3 focus:py-1"
>
	{t.navbar.skip}
</a>

<header class="sheet sticky top-0 z-40 nav-paper border-b-2 border-transparent data-scrolled:border-line" data-navbar>
	<div class="flex items-center gap-x-6 h-[calc(var(--cell)*3)]">
		<a href={home} class="font-extrabold tracking-tight text-lg text-text mr-auto hover:text-ink transition-colors">
			Douglas Maia
		</a>

		<nav aria-label="Principal" class="hidden sm:flex items-center gap-x-6 text-[0.9375rem]">
			{
				navItems.map(({ name, href, id }) => (
					<a
						href={href}
						data-nav-link={id}
						aria-current={isBlog && id === 'blog' ? 'page' : undefined}
						class="relative py-1 text-muted hover:text-ink transition-colors aria-[current]:text-ink aria-[current]:font-semibold after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-rule after:scale-x-0 after:origin-left after:transition-transform after:duration-300 aria-[current]:after:scale-x-100"
					>
						{name}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-x-1 font-mono text-xs" aria-label={t.navbar.language} role="group">
			{
				locales.map((lang, i) => (
					<>
						{i > 0 && <span class="text-muted" aria-hidden="true">/</span>}
						<a
							href={alternates.find((alt) => alt.locale === lang.locale)?.path}
							hreflang={lang.hreflang}
							lang={lang.hreflang}
							aria-current={lang.locale === locale ? 'true' : undefined}
							title={lang.title}
							class="px-1 py-1 text-muted hover:text-ink aria-[current]:text-rule aria-[current]:font-bold"
						>
							{lang.locale === 'en' ? 'EN' : 'PT'}
						</a>
					</>
				))
			}
		</div>

		<button
			type="button"
			data-theme-toggle
			data-label-light={t.navbar.themeLight}
			data-label-dark={t.navbar.themeDark}
			aria-label={t.navbar.themeDark}
			class="grid place-items-center size-cell text-muted hover:text-ink transition-colors cursor-pointer"
		>
			<Moon class="size-4 dark:hidden" aria-hidden="true" />
			<Sun class="size-4 hidden dark:block" aria-hidden="true" />
		</button>
	</div>
</header>

<nav
	aria-label="Principal"
	class="sm:hidden fixed bottom-0 inset-x-0 z-40 bg-paper border-t-2 border-line grid grid-cols-4 text-center text-sm"
>
	{
		navItems.map(({ name, href, id }) => (
			<a
				href={href}
				data-nav-link={id}
				aria-current={isBlog && id === 'blog' ? 'page' : undefined}
				class="py-3 text-muted aria-[current]:text-ink aria-[current]:font-semibold"
			>
				{name}
			</a>
		))
	}
</nav>

<script>
	const navbar = document.querySelector<HTMLElement>('[data-navbar]');
	const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
	const onHome = !location.pathname.includes('/blog');
	const sections = [...document.querySelectorAll<HTMLElement>('main > section[id]')];

	function setActive(id: string | null) {
		for (const link of links) {
			const target = link.dataset.navLink === 'blog' ? 'writing' : link.dataset.navLink;
			if (target === id) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	}

	function onScroll() {
		navbar?.toggleAttribute('data-scrolled', scrollY > 8);
		if (!onHome) return;
		let current: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top <= innerHeight * 0.4) current = section.id;
		}
		setActive(current);
	}

	addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const syncLabel = () => {
		if (!toggle) return;
		const dark = document.documentElement.dataset.theme === 'dark';
		toggle.setAttribute('aria-label', (dark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '');
	};
	syncLabel();
	toggle?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		syncLabel();
	});
</script>
