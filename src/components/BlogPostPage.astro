---
import { render } from 'astro:content';
import { ArrowLeft, ArrowRight, Link2 } from '@lucide/astro';

import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDict, localePath, type Locale } from '@/i18n';
import { formatDate, getPosts, postSlug, readingTimeMinutes, type BlogPost } from '@/lib/blog';

interface Props {
	locale: Locale;
	post: BlogPost;
}

const { locale, post } = Astro.props;
const t = getDict(locale);
const path = `/blog/${postSlug(post)}/`;
const url = new URL(localePath(locale, path), Astro.site).href;

const posts = await getPosts(locale);
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index < posts.length - 1 ? posts[index + 1] : undefined;

const share = [
	{ name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
	{ name: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${post.data.title} ${url}`)}` },
	{ name: 'X', href: `https://x.com/intent/post?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(url)}` },
];

const { Content } = await render(post);
---

<BaseLayout
	locale={locale}
	title={`${post.data.title} | Douglas Maia`}
	description={post.data.description}
	path={path}
	type="article"
	publishedTime={post.data.pubDate}
>
	<div class="reading-progress" aria-hidden="true" data-progress></div>
	<Navbar locale={locale} path={path} />

	<main id="main" class="pt-[calc(var(--cell)*3)]">
		<article>
			<header id="top" class="sheet">
				<p class="in-margin margin-note pt-[calc(var(--cell)*2.5)] tabular hidden md:block">
					<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(locale === 'pt-br' ? 'pt-BR' : 'en-US', { day: '2-digit', month: '2-digit', year: 'numeric' })}</time><br />
					{readingTimeMinutes(post.body)} {t.blog.minRead}
				</p>
				<div>
					<a href={localePath(locale, '/blog/')} class="ink-link inline-flex items-center gap-1 text-sm">
						<ArrowLeft class="size-4" aria-hidden="true" />
						{t.blog.backToBlog}
					</a>
					<p class="md:hidden mt-cell margin-note">
						{formatDate(post.data.pubDate, locale)} · {readingTimeMinutes(post.body)} {t.blog.minRead}
					</p>
					<h1 class="mt-cell max-w-[48rem] text-[clamp(2.25rem,6vw,4rem)] leading-[1.05] font-extrabold tracking-[-0.035em]">
						{post.data.title}
					</h1>
					<p class="mt-cell max-w-[42rem] text-lg leading-[calc(var(--cell)*1.25)] text-muted">{post.data.description}</p>
					{
						post.data.tags.length > 0 && (
							<p class="mt-cell flex flex-wrap gap-1.5">
								{post.data.tags.map((tag) => (
									<a href={`${localePath(locale, '/blog/')}?tag=${encodeURIComponent(tag)}`} class="chip">
										#{tag}
									</a>
								))}
							</p>
						)
					}
				</div>
			</header>

			<div class="sheet mt-[calc(var(--cell)*2)]">
				<div class="prose prose-notebook max-w-[42rem] border-t-2 border-line pt-cell">
					<Content />
				</div>
			</div>

			<footer class="sheet mt-[calc(var(--cell)*3)]">
				<p class="in-margin margin-note pt-cell uppercase">{t.blog.share}</p>
				<div class="max-w-[42rem] flex flex-wrap items-center gap-x-5 gap-y-2 border-t-2 border-line pt-cell">
					<button type="button" class="chip gap-1.5" data-copy={url} data-copied={t.blog.copied}>
						<Link2 class="size-3.5" aria-hidden="true" />
						<span>{t.blog.copy}</span>
					</button>
					{
						share.map(({ name, href }) => (
							<a href={href} target="_blank" rel="noopener noreferrer" class="ink-link text-sm">
								{name}
							</a>
						))
					}
					<span class="sr-only" role="status" data-copy-status></span>
				</div>
			</footer>
		</article>

		{
			(older || newer) && (
				<nav class="sheet mt-[calc(var(--cell)*3)]" aria-label="Posts">
					<div class="max-w-[42rem] grid sm:grid-cols-2 gap-cell">
						{older ? (
							<a href={localePath(locale, `/blog/${postSlug(older)}/`)} class="group ink-box p-cell hover:bg-ink-soft transition-colors">
								<span class="margin-note inline-flex items-center gap-1">
									<ArrowLeft class="size-3" aria-hidden="true" />
									{t.blog.previous}
								</span>
								<span class="block mt-1 font-extrabold text-lg leading-[calc(var(--cell)*1.1)] group-hover:text-ink">{older.data.title}</span>
							</a>
						) : (
							<span class="hidden sm:block" />
						)}
						{newer && (
							<a href={localePath(locale, `/blog/${postSlug(newer)}/`)} class="group ink-box p-cell text-right hover:bg-ink-soft transition-colors">
								<span class="margin-note inline-flex items-center gap-1">
									{t.blog.next}
									<ArrowRight class="size-3" aria-hidden="true" />
								</span>
								<span class="block mt-1 font-extrabold text-lg leading-[calc(var(--cell)*1.1)] group-hover:text-ink">{newer.data.title}</span>
							</a>
						)}
					</div>
				</nav>
			)
		}
	</main>
	<Footer locale={locale} />
</BaseLayout>

<style>
	/* Reading progress inks over the red margin rule, top to bottom. */
	.reading-progress {
		position: fixed;
		inset-block: 0;
		left: calc(var(--margin) - 2px);
		width: 2px;
		z-index: 2;
		background: var(--ink);
		transform-origin: top;
		transform: scaleY(var(--progress, 0));
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>('[data-progress]');
	const update = () => {
		const max = document.documentElement.scrollHeight - innerHeight;
		bar?.style.setProperty('--progress', String(max > 0 ? Math.min(1, scrollY / max) : 1));
	};
	addEventListener('scroll', update, { passive: true });
	addEventListener('resize', update);
	update();

	const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
	const status = document.querySelector<HTMLElement>('[data-copy-status]');
	copy?.addEventListener('click', async () => {
		const label = copy.querySelector('span');
		const original = label?.textContent ?? '';
		try {
			await navigator.clipboard.writeText(copy.dataset.copy ?? location.href);
			if (label) label.textContent = copy.dataset.copied ?? '';
			if (status) status.textContent = copy.dataset.copied ?? '';
			copy.setAttribute('aria-pressed', 'true');
			setTimeout(() => {
				if (label) label.textContent = original;
				copy.setAttribute('aria-pressed', 'false');
			}, 2000);
		} catch {
			prompt('', copy.dataset.copy ?? location.href);
		}
	});
</script>
