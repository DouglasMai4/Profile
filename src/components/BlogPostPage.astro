---
import { render } from 'astro:content';
import { ArrowLeft, CalendarDays, Clock } from '@lucide/astro';

import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getDict, localePath, type Locale } from '@/i18n';
import { formatDate, postSlug, readingTimeMinutes, type BlogPost } from '@/lib/blog';

interface Props {
	locale: Locale;
	post: BlogPost;
}

const { locale, post } = Astro.props;
const t = getDict(locale);
const path = `/blog/${postSlug(post)}/`;

const { Content } = await render(post);
---

<BaseLayout
	locale={locale}
	title={`${post.data.title} | Douglas Maia`}
	description={post.data.description}
	path={path}
	type="article"
	publishedTime={post.data.pubDate}
>
	<main class="min-h-dvh py-24 md:pt-32 px-4 relative overflow-hidden bg-background">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-96 bg-primary/5 blur-[120px] rounded-full pointer-events-none"></div>

		<article class="container mx-auto max-w-3xl relative z-10">
			<a
				href={localePath(locale, '/blog/')}
				class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors mb-8 group"
			>
				<ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
				{t.blog.backToBlog}
			</a>

			<header class="mb-10 space-y-4">
				<div class="flex flex-wrap items-center gap-4 text-xs text-muted-foreground font-mono">
					<span class="flex items-center gap-1.5">
						<CalendarDays class="w-3.5 h-3.5" />
						<time datetime={post.data.pubDate.toISOString()}>
							{formatDate(post.data.pubDate, locale)}
						</time>
					</span>
					<span class="flex items-center gap-1.5">
						<Clock class="w-3.5 h-3.5" />
						{readingTimeMinutes(post.body)} {t.blog.minRead}
					</span>
				</div>

				<h1 class="text-3xl md:text-5xl font-bold font-mono tracking-tight text-foreground">
					{post.data.title}
				</h1>

				<p class="text-lg text-muted-foreground leading-relaxed">{post.data.description}</p>

				{
					post.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<span class="text-xs px-2 py-1 rounded bg-primary/10 text-primary border border-primary/20">
									{tag}
								</span>
							))}
						</div>
					)
				}
			</header>

			<div
				class="prose prose-invert prose-headings:font-mono prose-a:text-primary prose-a:decoration-primary/30 prose-a:underline-offset-4 prose-code:text-primary prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-white/5 max-w-none"
			>
				<Content />
			</div>
		</article>
	</main>

	<Footer locale={locale} />
	<Navbar locale={locale} path={path} />
</BaseLayout>
