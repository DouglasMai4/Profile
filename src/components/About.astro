---
import {
	CodeXml,
	Cpu,
	Database,
	ExternalLink,
	Server,
	Terminal,
	UserRound,
	Wrench,
} from '@lucide/astro';

import Badge from '@/components/ui/Badge.astro';
import { getDict, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

const techCategories = [
	{
		id: 'frontend',
		Icon: CodeXml,
		title: t.about.stacks.frontend,
		techs: ['React', 'Astro', 'Tailwind'],
		color: 'text-blue-400',
		bg: 'bg-blue-500/10',
		border: 'hover:border-blue-500/50',
	},
	{
		id: 'backend',
		Icon: Server,
		title: t.about.stacks.backend,
		techs: ['Node.js', 'Bun', 'Express', 'Hono', 'Rust'],
		color: 'text-emerald-400',
		bg: 'bg-emerald-500/10',
		border: 'hover:border-emerald-500/50',
	},
	{
		id: 'database',
		Icon: Database,
		title: t.about.stacks.database,
		techs: ['PostgreSQL', 'MySQL', 'MongoDB'],
		color: 'text-purple-400',
		bg: 'bg-purple-500/10',
		border: 'hover:border-purple-500/50',
	},
	{
		id: 'tools',
		Icon: Wrench,
		title: t.about.stacks.tools,
		techs: ['Tauri', 'Drizzle', 'Docker', 'Linux'],
		color: 'text-orange-400',
		bg: 'bg-orange-500/10',
		border: 'hover:border-orange-500/50',
	},
];
---

<section id="about" class="py-24 px-4 relative overflow-hidden bg-background mt-50 md:mt-0 min-h-dvh">
	<div class="absolute top-40 left-0 w-72 h-72 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
	<div class="absolute bottom-20 right-0 w-96 h-96 bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"></div>

	<div class="container mx-auto max-w-6xl relative z-10">
		<div class="grid lg:grid-cols-[1.2fr_1fr] gap-16 items-start">
			<div class="space-y-10">
				<div class="flex justify-start animate-in-view">
					<Badge>
						<UserRound class="w-4 h-4 mr-2" />
						{t.about.badge}
					</Badge>
				</div>

				<h2
					class="text-4xl md:text-5xl font-bold font-mono tracking-tight text-foreground animate-in-view"
					style="--stagger: 0.15s"
				>
					<span class="text-primary mr-2">&lt;</span>{t.about.title}<span class="text-primary ml-2"
						>/&gt;</span
					>
				</h2>

				<p
					class="prose prose-lg prose-invert text-muted-foreground leading-relaxed animate-in-view"
					style="--stagger: 0.3s"
					set:html={t.about.contentHtml}
				/>

				<div
					class="relative group rounded-xl overflow-hidden border border-white/10 bg-zinc-900/50 backdrop-blur-sm hover:scale-[1.02] transition-transform duration-300 animate-in-view"
					style="--stagger: 0.45s"
				>
					<div
						class="absolute inset-0 bg-linear-to-r from-primary/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
					>
					</div>

					<div class="p-6 flex items-center gap-5 relative z-10">
						<div
							class="w-12 h-12 rounded-lg bg-linear-to-br from-primary to-purple-600 flex items-center justify-center shadow-lg shadow-primary/20 group-hover:shadow-primary/40 transition-shadow"
						>
							<Cpu class="w-6 h-6" />
						</div>

						<div class="flex-1">
							<p class="text-xs font-mono text-primary mb-1 uppercase tracking-wider">Founder</p>
							<a
								href="https://kingdomsoftwares.com.br"
								target="_blank"
								rel="noopener noreferrer"
								class="text-xl font-bold text-foreground group-hover:text-primary transition-colors flex items-center gap-2"
							>
								Kingdom Softwares
								<ExternalLink
									class="w-4 h-4 opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all"
								/>
							</a>
							<p class="text-sm text-muted-foreground mt-1">{t.about.founderDescription}</p>
						</div>
					</div>
				</div>
			</div>

			<div class="space-y-8">
				<div class="flex justify-center lg:justify-end mb-8 animate-in-view">
					<div class="relative w-48 h-48 animate-float" style="animation-duration: 4s">
						<div
							class="absolute inset-0 bg-linear-to-tr from-primary to-purple-500 rounded-2xl rotate-6 blur-2xl opacity-40 animate-pulse"
						>
						</div>
						<div
							class="relative w-full h-full rounded-2xl overflow-hidden border-2 border-white/10 shadow-2xl bg-zinc-800"
						>
							<img
								src="https://github.com/DouglasMai4.png"
								alt="Douglas Maia"
								width="192"
								height="192"
								loading="lazy"
								decoding="async"
								class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-700"
							/>
						</div>
					</div>
				</div>

				<div class="space-y-4 animate-in-view" style="--stagger: 0.15s">
					<div class="flex items-center gap-2 text-muted-foreground mb-4">
						<Terminal class="w-4 h-4" />
						<span class="text-sm font-mono">stack.config.json</span>
						<div class="h-px bg-border flex-1 ml-2"></div>
					</div>

					<div class="grid gap-3">
						{
							techCategories.map(({ Icon, title, techs, color, bg, border }) => (
								<div
									class:list={[
										'group relative p-4 rounded-xl border border-white/5 bg-zinc-900/40 backdrop-blur-md transition-all duration-300 hover:bg-zinc-900/80',
										border,
									]}
								>
									<div class="flex items-start gap-4">
										<div class:list={['p-2.5 rounded-lg', bg, color]}>
											<Icon class="w-5 h-5" />
										</div>

										<div class="flex-1">
											<h4 class="text-sm font-semibold text-foreground mb-2 flex items-center justify-between">
												{title}
												<span
													class:list={[
														'hidden group-hover:inline-flex text-[10px] px-2 py-0.5 rounded-full bg-white/5 border border-white/10',
														color,
													]}
												>
													{techs.length} skills
												</span>
											</h4>

											<div class="flex flex-wrap gap-1.5">
												{techs.map((tech) => (
													<span class="text-xs px-2 py-1 rounded bg-white/5 text-zinc-400 border border-transparent transition-colors group-hover:border-white/10 group-hover:text-zinc-200">
														{tech}
													</span>
												))}
											</div>
										</div>
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
